# Build environment for Aileron's Fedora package.
#
# The .rpm must be built against the Fedora release it ships to: a binary
# built on a newer distribution (Arch, for one) links against a newer glibc
# and will not start on Fedora.
ARG FEDORA_VERSION=44
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION}

RUN dnf install -y --setopt=install_weak_deps=False \
      gcc gcc-c++ make pkgconf-pkg-config file curl wget rpm-build \
      webkit2gtk4.1-devel gtk3-devel libappindicator-gtk3-devel librsvg2-devel \
      openssl-devel libxdo-devel pulseaudio-libs-devel alsa-lib-devel \
      libxcb-devel libXrandr-devel dbus-devel pipewire-devel clang-devel \
      nodejs npm \
    && dnf clean all

# Rust from rustup, not Fedora's package, so the toolchain matches the Mac.
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain stable

WORKDIR /src
